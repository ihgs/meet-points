# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

.claude/skills/*-workspace/

# GTFS database
data/*.db

# Visual regression: Linux baselines only are committed
# (macOS/Windows local runs produce platform-suffixed PNGs that are throwaway)
**/__screenshots__/**/*-darwin.png
**/__screenshots__/**/*-win32.png
**/__screenshots__/**/*-actual-*.png
**/__screenshots__/**/*-diff-*.png