{
  "name": "mannaka",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:vrt": "vitest run --project storybook --project storybook-mobile",
    "test:vrt:update": "vitest run --project storybook --project storybook-mobile -u",
    "test:vrt:mobile": "vitest run --project storybook-mobile",
    "test:vrt:mobile:update": "vitest run --project storybook-mobile -u",
    "fetch-stations": "tsx scripts/fetch-stations.ts",
    "export-data": "tsx scripts/export-data.ts",
    "build:gh-pages": "NEXT_PUBLIC_BASE_PATH=/meet-points next build",
    "deploy:gh-pages": "pnpm build:gh-pages && gh-pages -d out -b gh-pages --nojekyll -t"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.4",
    "next": "16.2.4",
    "postcss": "^8.5.13",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-storybook": "^10.3.6",
    "gh-pages": "^6.3.0",
    "playwright": "^1.59.1",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
